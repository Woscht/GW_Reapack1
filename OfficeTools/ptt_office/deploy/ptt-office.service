[Unit]
Description=Project Time Tracker office web UI (FastAPI)
Documentation=file:///opt/ptt_office/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated service account with read access to the SMB mirror (see README).
User=ptt
Group=ptt
WorkingDirectory=/opt/ptt_office

# Mirrored JSONL from REAPER clients (UNC or local mount path on the server).
Environment=PTT_TIMELOGS_DIR=/mnt/zeiterfassung/timelogs
# SQLite state for ingest + web UI.
Environment=PTT_SQLITE_PATH=/var/lib/ptt_office/ptt_office.sqlite

ExecStart=/opt/ptt_office/.venv/bin/uvicorn ptt_office.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
